        <mxCell id="card_legend" value="&lt;b&gt;PANDUAN NOTASI &amp;amp; KARDINALITAS RELASI UML 2.5&lt;/b&gt;&lt;br/&gt;&lt;table style=&quot;width:100%; font-size:10px; margin-top:6px; line-height:1.5;&quot;&gt;&lt;tr&gt;&lt;td width=&quot;30%&quot;&gt;&lt;b style=&quot;color:#DC2626;&quot;&gt;&amp;#9670; Komposisi (Diamond Hitam):&lt;/b&gt;&lt;br/&gt;Pesanan &amp;rarr; DetailPesanan, Pesanan &amp;rarr; RiwayatStatus&lt;br/&gt;&lt;i&gt;Ketergantungan penuh (Cascade Delete)&lt;/i&gt;&lt;/td&gt;&lt;td width=&quot;35%&quot;&gt;&lt;b style=&quot;color:#0284C7;&quot;&gt;&amp;#9671; Agregasi (Diamond Kosong):&lt;/b&gt;&lt;br/&gt;Kategori &amp;rarr; Menu, Meja &amp;rarr; Pesanan&lt;br/&gt;&lt;i&gt;Hubungan kepemilikan independen&lt;/i&gt;&lt;/td&gt;&lt;td width=&quot;35%&quot;&gt;&lt;b style=&quot;color:#7C3AED;&quot;&gt;&amp;rarr; Asosiasi &amp;amp; Multiplicity:&lt;/b&gt;&lt;br/&gt;&lt;b&gt;1:1&lt;/b&gt; Login &amp;rarr; User (Mengautentikasi)&lt;br/&gt;&lt;b&gt;1:N&lt;/b&gt; User &amp;rarr; Pembayaran / Pesanan / Pengeluaran&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;rounded=1;shadow=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=left;spacingLeft=14;spacingRight=14;fontSize=10;" vertex="1" parent="1"><mxGeometry x="370" y="915" width="890" height="170" as="geometry"/></mxCell>
