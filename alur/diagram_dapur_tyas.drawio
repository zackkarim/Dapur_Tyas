        <mxCell id="title" value="&lt;b&gt;CLASS DIAGRAM LENGKAP SISTEM RESTORAN — DAPUR TYAS&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; font-weight: normal;&quot;&gt;Mencakup Seluruh Entitas Database &amp;amp; Modul Login dengan Keterangan Relasi Lengkap (Standar Notasi UML 2.5)&lt;/font&gt;" style="html=1;whiteSpace=wrap;fillColor=#0F172A;strokeColor=#0284C7;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=13;rounded=1;shadow=1;align=center;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1210" height="48" as="geometry"/></mxCell>
        <mxCell id="cls_kategori" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Arial,sans-serif;&quot;&gt;&lt;tr style=&quot;background:#0284C7; color:#FFFFFF;&quot;&gt;&lt;td style=&quot;padding:6px 8px; text-align:center; font-weight:bold; font-size:11px;&quot;&gt;Kategori&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:8px 10px; border-bottom:1px solid #E2E8F0; font-family:Consolas,monospace; font-size:10px; line-height:1.35; color:#0F172A;&quot;&gt;- id : int&lt;br/&gt;- nama_kategori : string&lt;br/&gt;- slug : string&lt;br/&gt;- urutan : int&lt;br/&gt;- created_at : datetime&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:8px 10px; font-family:Consolas,monospace; font-size:10px; line-height:1.35; color:#0F172A;&quot;&gt;+ getKategori() : array&lt;br/&gt;+ simpanKategori() : bool&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;rounded=1;shadow=1;overflow=hidden;align=left;verticalAlign=top;spacingTop=0;spacingLeft=0;spacingRight=0;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="95" width="250" height="195" as="geometry"/></mxCell>
