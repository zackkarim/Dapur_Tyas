        <mxCell id="title" value="&lt;div class=&quot;notranslate&quot; translate=&quot;no&quot;&gt;&lt;b style=&quot;font-size: 16px;&quot;&gt;USE CASE DIAGRAM — SISTEM POS DAPUR TYAS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #94A3B8;&quot;&gt;by TECNO GARAGE — Hak Akses Lengkap &amp; Terstruktur: Pelanggan (Meja), Kasir (POS), dan Administrator&lt;/span&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fillColor=#0F172A;strokeColor=#1E293B;fontColor=#FFFFFF;fontSize=13;rounded=1;shadow=1;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1120" height="55" as="geometry" /></mxCell>
